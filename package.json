{
  "name": "totalcrm",
  "version": "0.1.0",
  "private": true,
  "description": "CRM omnicanal (WhatsApp, Instagram, Messenger, TikTok) instalable por empresa",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @totalcrm/db generate",
    "db:migrate": "pnpm --filter @totalcrm/db migrate",
    "db:studio": "pnpm --filter @totalcrm/db studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  }
}
