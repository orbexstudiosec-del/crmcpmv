# En un servidor NO se edita a mano: `./install.sh` genera el .env con claves aleatorias.
# Este archivo sirve de referencia y para desarrollo local (copia a .env y ajusta).

# ─── Marca y primera puesta en marcha ────────────────────────────
# Nombre con el que se presenta el CRM (pestaña, login, menú, correos). Después se cambia
# en Configuración → Marca, junto con el logo y el color.
APP_NAME="CPMV CRM"
# Empresa y administrador que se crean en el primer arranque (solo si la base está vacía).
COMPANY_NAME="Cooperativa Pablo Muñoz Vega"
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@miempresa.com"
ADMIN_PASSWORD="cambia-esta-clave"

# ─── Secretos (genera cada uno con: openssl rand -hex 32) ─────────
# Firma las sesiones. Sin un valor de al menos 32 caracteres el API no arranca.
AUTH_SECRET=""
# Cifra las credenciales de los canales (tokens de Meta). 64 hex.
# Si se pierde o cambia, hay que volver a conectar todas las integraciones.
ENCRYPTION_KEY=""

# ─── Base de datos ───────────────────────────────────────────────
# Desarrollo local: Postgres en tu máquina. En Docker lo arma docker-compose.yml a partir
# de POSTGRES_PASSWORD.
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"
POSTGRES_PASSWORD=""

# ─── Publicación ─────────────────────────────────────────────────
# Dominio (HTTPS automático) o ":80" para servir por IP sin HTTPS.
SITE_ADDRESS=":80"
# URL pública del CRM: se usa para CORS y para los enlaces de los correos.
WEB_URL="http://localhost:3000"
TZ="America/Guayaquil"

# ─── Correo institucional (obligatorio en producción) ───────────
# El acceso depende del correo: cada usuario activa su cuenta con un enlace enviado a su correo
# institucional y, en cada inicio de sesión, recibe ahí un código de 6 dígitos.
# Dominios aceptados para las cuentas, separados por coma (vacío = cualquiera, solo desarrollo).
CORREO_DOMINIOS_PERMITIDOS=""
# En desarrollo, sin SMTP_HOST los enlaces y códigos se imprimen en el log del API. En
# producción (NODE_ENV=production) no: sin SMTP nadie puede activar su cuenta ni iniciar sesión.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ─── IA del Cronopost (opcional) ─────────────────────────────────
# La API key de OpenAI se carga desde el CRM: Configuración → Inteligencia artificial (se guarda
# cifrada con ENCRYPTION_KEY). Estas variables son solo un respaldo: se usan si en la pantalla no
# hay ninguna clave cargada. A la IA viajan la configuración de la marca, el tema y las
# indicaciones que escribe el usuario: nunca datos de socios.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Opcional: proxy o gateway interno compatible con la API de OpenAI (o Azure OpenAI), para no
# salir directo a internet. Vacío = https://api.openai.com/v1
OPENAI_BASE_URL=""
